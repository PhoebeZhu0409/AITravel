<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/">Home</a></li>
    <li><a href="/trips/<%= @the_trip.id %>"><%= @the_trip.trip_name%></a></li>
    <li>Rebuild My Agenda</li>
  </ul>
</nav>
<hr>

<% if user_signed_in? && !current_user.premium? %>
  <% rem = current_user.trip_generations_remaining %>
  <% if rem.positive? %>
    <p class="trip-generation-quota trip-generation-quota--plain" role="status">
      <%= rem %> free trip generations remaining.
    </p>
  <% else %>
    <p class="trip-generation-quota trip-generation-quota--plain trip-generation-quota--plain-warn" role="status">
      You have run out of 5 free trip generations within the last 6 months.
    </p>
  <% end %>
<% end %>

<% pf = @rebuild_prefill || ::RebuildFormPrefill.from_trip_notes(nil) %>
<% todos_saved = Array(pf[:todos]).map(&:to_s) %>
<% optional_open = pf[:budget].present? || pf[:people].present? || pf[:live_area].present? || todos_saved.any? %>

<article>
  <header>
    <h2>
      Trip details
    </h2>
  </header>

  <form id="rebuild-agenda-form" action="/modify_trip/<%= @the_trip.id %>" method="post">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <div>
      <label for="trip_name_box">
        Trip name
      </label>

      <input type="text" id="trip_name_box" name="query_trip_name" value="<%= @the_trip.trip_name %>">
    </div>

      <div>
        <label for="trip_location_box">Location</label>
        <input type="text"
         id="trip_location_box"
         name="query_trip_location"
         value="<%= @the_trip.trip_location %>"
         placeholder="Search a city..."
         autocomplete="off">
      </div>

    <div>
      <label for="trip_duration_days_box">
        How many days
      </label>

      <input type="number" id="trip_duration_days_box" name="query_trip_duration_days" value="<%= @the_trip.trip_duration_days %>"  step="1">
    </div>

    <div>
      <label for="trip_start_date_box">
        Trip starts
      </label>

      <input type="date" id="trip_start_date_box" name="query_trip_start_date" value="<%= @the_trip.trip_start_date&.strftime("%Y-%m-%d") %>">
    </div>

      <!-- Collapsible section -->
      <details class="collapsible"<%= " open".html_safe if optional_open %>>
        <summary class="collapsible-btn">Tell me more?</summary>

        <div class="content">

          <article>
            <div>
              <label>You want my trip to be...</label>
              <label><input type="radio" name="query_budget" value="luxury"<%= " checked".html_safe if pf[:budget].to_s == "luxury" %>> Luxury</label>
              <label><input type="radio" name="query_budget" value="budget friendly"<%= " checked".html_safe if pf[:budget].to_s == "budget friendly" %>> Budget friendly  </label>
              <label><input type="radio" name="query_budget" value="A mix of both luxury and budget friendly"<%= " checked".html_safe if pf[:budget].to_s == "A mix of both luxury and budget friendly" %>> A mix of both</label>
            </div>
            <hr>
            <div>
              <label>You are...</label>
              <label><input type="radio" name="query_people" value="solo traveling"<%= " checked".html_safe if pf[:people].to_s == "solo traveling" %>> Solo traveling</label>
              <label><input type="radio" name="query_people" value="traveling with my partner"<%= " checked".html_safe if pf[:people].to_s == "traveling with my partner" %>>Traveling with my partner</label>
              <label><input type="radio" name="query_people" value="traveling with my friends"<%= " checked".html_safe if pf[:people].to_s == "traveling with my friends" %>>Traveling with my friends</label>
              <label><input type="radio" name="query_people" value="traveling with my family"<%= " checked".html_safe if pf[:people].to_s == "traveling with my family" %>>Traveling with my family</label>
            </div>
            <hr>
            <div>
              <label>Your trip should include...</label>
              <div>
                <% v = "Local's favorite resturants or spots, or things to do that involves local culture " %>
                <label><input type="checkbox" name="query_todo[]" value="<%= v %>"<%= " checked".html_safe if todos_saved.include?(v) %>>Local's favorite food or spot, culture </label>
              </div>
              <div>
                <% v = "Museums, art, and history" %>
                <label><input type="checkbox" name="query_todo[]" value="<%= v %>"<%= " checked".html_safe if todos_saved.include?(v) %>>Museums, art, history</label>
              </div>
              <div>
                <% v = "Outdoors & nature" %>
                <label><input type="checkbox" name="query_todo[]" value="<%= v %>"<%= " checked".html_safe if todos_saved.include?(v) %>>Outdoors, nature</label>
              </div>
              <div>
                <% v = "Nightlife & bars" %>
                <label><input type="checkbox" name="query_todo[]" value="<%= v %>"<%= " checked".html_safe if todos_saved.include?(v) %>>Nightlife, bars</label>
              </div>
              <div>
                <% v = "Shopping" %>
                <label><input type="checkbox" name="query_todo[]" value="<%= v %>"<%= " checked".html_safe if todos_saved.include?(v) %>>Shopping</label>
              </div>
              <div>
                <% v = "High-end restaurants and luxury experience" %>
                <label><input type="checkbox" name="query_todo[]" value="<%= v %>"<%= " checked".html_safe if todos_saved.include?(v) %>>High-end restaurants and luxury experience </label>
              </div>
            </div>
          </article>

          <article>
            <div>
              <label for="live_area">
                Which area do you live? 
              </label>

              <input type="text" id="live_area" name="query_live_area" value="<%= pf[:live_area] %>">
            </div>

          </article>

        </div>
      </details>
      <!-- Collapsible section -->
      


      <article class="trip-notes-section">
        <div>
          <label for="trip_notes_box">
            Anything else you want to tell me about? 
          </label>
          <% placeholder_text = <<~TEXT
            I would prefer...
            My goal is...
            I have to...
            I arrive/leave at...
            TEXT
          %>
          <textarea id="trip_notes_box" name="query_trip_notes" rows="4" placeholder="<%= placeholder_text %>"><%= pf[:trip_notes] %></textarea>
        </div>

      </article>

    <% rebuild_quota_full = user_signed_in? && !current_user.premium? && !current_user.can_generate_trip? %>
    <button type="submit"<%= " disabled aria-disabled=\"true\"".html_safe if rebuild_quota_full %>>
      Rebuild my agenda!
    </button>


  </form>

  <%= render "trip_templates/agenda_loading_overlay" %>
</article>
