<%# locals: trips, list_id %>
<div class="trips-list-wrap">
  <ul id="<%= list_id %>" class="trips-list">
    <% trips.each do |a_trip| %>
      <li>
        <div class="trips-card">
          <%= app_link_to "/trips/#{a_trip.id}", class: "trips-card-main" do %>
            <img
              class="trips-card-thumb"
              src="<%= trip_show_hero_src(a_trip) %>"
              alt=""
              onerror="<%= trip_hero_image_onerror %>">
            <span class="trips-card-body">
              <span class="trips-card-name"><%= a_trip.trip_name %></span>
              <% if a_trip.trip_start_date.present? %>
                <span class="trips-card-date"><%= trip_display_date(a_trip.trip_start_date) %></span>
              <% end %>
            </span>
          <% end %>
          <div class="trips-card-aside">
            <time class="trips-card-created" datetime="<%= a_trip.created_at.iso8601 %>">
              <span class="trips-card-created-label">Created on</span>
              <span class="trips-card-created-date"><%= trip_display_date(a_trip.created_at.to_date) %></span>
            </time>
          </div>
          <%= link_to "×",
              "/delete_trip/#{a_trip.id}",
              class: "trips-list-delete",
              title: "Delete trip",
              aria: { label: "Delete #{a_trip.trip_name}" },
              data: {
                turbo: false,
                delete_confirm: "Delete “#{a_trip.trip_name}”? This cannot be undone.",
                delete_inplace: true
              } %>
        </div>
      </li>
    <% end %>
  </ul>
</div>
