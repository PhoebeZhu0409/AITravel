<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/">Home</a></li>
    <li><%= @the_trip.trip_name%></li>
  </ul>
</nav>
<hr>

<h1>
  <%= @the_trip.trip_name %>
</h1>

<a href="/delete_trip/<%= @the_trip.id %>">
  Delete this trip
</a>

<article>

  <div class="overflow-auto">
    <table>
      <thead>
        <th>Location</th>
        <th>Trip Starts</th>
        <th>Days</th>
        <th>You preferences</th>
        <th> </th>
      </thead>

      <tbody>
        <tr>
          <td>
            <%= @the_trip.trip_location %>
          </td>
          <td>
            <%= Date.parse(@the_trip.trip_start_date)  %><!--.strftime("%b %e, %Y")-->
          </td>
          <td>
            <%= @the_trip.trip_duration_days %>
          </td>
          <td>
            <%= @the_trip.my_preference%>
          </td>
          <td>
            <a href="/modify/<%= @the_trip.id %>">
              Rebuild my agenda
            </a>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</article>
<hr>

<h1>
  My Agenda
</h1>

<%
  start_date = Date.parse(@the_trip.trip_start_date)
  end_date = Date.parse(@the_trip.trip_start_date) + @the_trip.trip_duration_days.day-1.day
%>

<% (start_date..end_date).each_with_index do |date, i| %>
  <div>
    <article>

      <div class="overflow-auto">
        <div class="day-header">Day <%= i + 1 %>: <%= date.strftime("%B %-d, %Y") %></div>
        <% this_day = @the_trip.trip_plans.where(date: date.strftime("%Y-%m-%d")) %>

        <table>
          <thead>
            <th>From</th>
            <th>To</th>
            <th>Plan</th>
            <th>Location</th>
            <th>Get around</th>
          </thead>

          <tbody>
            <% this_day.each do |a_day| %>
              <tr>
                <td><%= a_day.start_time.strftime("%I:%M&nbsp;%p").html_safe %></td>
                <td><%= a_day.end_time.strftime("%I:%M&nbsp;%p").html_safe %></td>
                <td><%= a_day.trip_plan %></td>
                <td>
                  <% short_loc = a_day.plan_location.split(",").first %>
                  <%= link_to short_loc,
                  "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode(a_day.plan_location)}",
                  target: "_blank",
                  rel: "noopener" %>
                </td>
                <td><%= a_day.plan_details %></td>

              </tr>
            <% end %>
          </tbody>
        </table>
        
    <div
      id="map-day-<%= i + 1 %>"
      class="day-map"
      data-locations="<%= h(this_day.map { |p|
          { label: p.plan_location.split(",").first.split(" or ").first, address: p.plan_location }
        }.to_json) %>">
    </div>
      </div>

    </article>
  </div>
<% end %>
