<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/">Home</a></li>
    <li><%= @the_trip.trip_name%></li>
  </ul>
</nav>
<hr>

<h1>
  <%= @the_trip.trip_name %>
</h1>

<a href="/delete_trip/<%= @the_trip.id %>">
  Delete this trip
</a>

<article>

  <div class="overflow-auto">
    <table>
      <thead>
        <th>Location</th>
        <th>Trip Starts</th>
        <th>Days</th>
        <th> </th>
      </thead>

      <tbody>
        <tr>
          <td>
            <%= @the_trip.trip_location %>
          </td>
          <td>
            <%= Date.parse(@the_trip.trip_start_date)  %><!--.strftime("%b %e, %Y")-->
          </td>
          <td>
            <%= @the_trip.trip_duration_days %>
          </td>
          <td>
            <a href="/modify/<%= @the_trip.id %>">
              Rebuild my agenda
            </a>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</article>
<hr>

<h1>
  My Agenda
</h1>


<%
  start_date = Date.parse(@the_trip.trip_start_date)
  end_date = Date.parse(@the_trip.trip_start_date) + @the_trip.trip_duration_days.day-1.day
%>

<% (start_date..end_date).each_with_index do |date, i| %>
  <div>
    <article>
      <div class="overflow-auto">
        <div>
          <strong>Day <%= i + 1 %>:</strong> <%= date.strftime("%Y-%m-%d") %>
          <div>
          <% this_trip = @the_trip.trip_plans.where(date: date.strftime("%Y-%m-%d")) %>
          <% this_trip.each do |a_trip| %>
          <table>          
          <thead>
            <th>From</th>
            <th>To</th>
            <th>Plan</th>
            <th>Location</th>
          </thead>

          <tbody>
          <td><%= a_trip.start_time.strftime("%X") %></td>
          <td><%= a_trip.end_time.strftime("%X") %></td>
          <td><%= a_trip.trip_plan %></td>
          <td><%= a_trip.plan_location %></td>
          </tbody></table>
          <% end %>
          </div>

    </article>
  </div>
<% end %>
