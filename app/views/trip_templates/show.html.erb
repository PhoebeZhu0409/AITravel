<h1>
  Trip #<%= @the_trip.id %> details
</h1>

<article>
  <div>
    <a href="/trips">
      Go back
    </a>
  </div>

  <div>
    <a href="/delete_trip/<%= @the_trip.id %>">
      Delete trip
    </a>
  </div>
  <dl>
    <dt>
      Trip name
    </dt>
    <dd>
      <%= @the_trip.trip_name %>
    </dd>

    <dt>
      Trip location
    </dt>
    <dd>
      <%= @the_trip.trip_location %>
    </dd>

    <dt>
      Trip duration days
    </dt>
    <dd>
      <%= @the_trip.trip_duration_days %>
    </dd>

    <dt>
      Trip start date
    </dt>
    <dd>
      <%= @the_trip.trip_start_date %>
    </dd>

    <dt>
      Trip notes
    </dt>
    <dd>
      <%= @the_trip.trip_notes %>
    </dd>

    <dt>
      Created at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_trip.created_at) %> ago
    </dd>

    <dt>
      Updated at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_trip.updated_at) %> ago
    </dd>
  </dl>
</article>

<hr>


<article>
  <header>
    <h2>
      Edit trip
    </h2>
  </header>

  <form action="/modify_trip/<%= @the_trip.id %>"  method="post" >
    <div>
      <label for="trip_name_box">
        Trip name
      </label>

      <input type="text" id="trip_name_box" name="query_trip_name" value="<%= @the_trip.trip_name %>">
    </div>

    <div>
      <label for="trip_location_box">
        Trip location
      </label>

      <input type="text" id="trip_location_box" name="query_trip_location" value="<%= @the_trip.trip_location %>">
    </div>

    <div>
      <label for="trip_duration_days_box">
        Trip duration days
      </label>

      <input type="text" id="trip_duration_days_box" name="query_trip_duration_days" value="<%= @the_trip.trip_duration_days %>">
    </div>

    <div>
      <label for="trip_start_date_box">
        Trip start date
      </label>

      <input type="text" id="trip_start_date_box" name="query_trip_start_date" value="<%= @the_trip.trip_start_date %>">
    </div>

    <div>
      <label for="trip_notes_box">
        Trip notes
      </label>

      <input type="text" id="trip_notes_box" name="query_trip_notes" value="<%= @the_trip.trip_notes %>">
    </div>

    <button type="submit">
      Update trip
    </button>
  </form>
</article>

<hr>
