<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/">Home</a></li>
    <li><%= @the_trip.trip_name%></li>
  </ul>
</nav>
<hr>

<article>
  <div class="trip-hero">
    <% location = @the_trip.trip_location %>
    <% location = location.gsub(", ", "_")%>

    <img
    src="https://loremflickr.com/1200/400/<%=location%>"
    alt="<%= location %>"
    style="width: 9000px; height: auto; border-radius: 8px;"
  >

      <!-----------------------------------------Botton:   Update trip name. ------------------------------------------>
      <!------------ VIEW MODE ------------>
      <div id="trip-name-view"
     style="display: flex; align-items: center; gap: 10px;">

        <h1 style="margin: 30px 0;">
          <%= @the_trip.trip_name %>
        </h1>

        <button type="button"
          id="edit-trip-name-btn"
          data-nopico
          style="background: none; border: none; padding: 4px; cursor: pointer;">
          ✏️
        </button>
      </div>

      <!------------ EDIT MODE (hidden by default) ------------>
      <div id="trip-name-edit"
     style="display: none; flex-direction: column; gap: 10px;">

        <%= form_with model: @the_trip,
                url: "/trip_name_update/#{@the_trip.id}",
                method: :post,
                local: true do |form| %>

          <input type="text"
           name="query_trip_name"
           value="<%= @the_trip.trip_name %>"
           style="font-size: 1.5rem; padding: 4px; width: 100%;">

          <!-- BUTTON ROW -->
          <div style="display: flex; gap: 10px;">

            <button type="submit"
              data-nopico
              style="
                padding: 8px 20px;
                background: #1c6fb8;
                color: white;
                border-radius: 6px;
                border: none;
                cursor: pointer;
                display: inline-block;
                width: auto;
              ">
              Save
            </button>

            <button type="button"
              id="cancel-trip-name-btn"
              data-nopico
              style="
                padding: 8px 20px;
                background: #999;
                color: white;
                border-radius: 6px;
                border: none;
                cursor: pointer;
                display: inline-block;
                width: auto;
              ">
              Cancel
            </button>

          </div>

        <% end %>
      </div>
      <!-------------------------------------------------------------------------------------------------------------------->

      <div>
        <div><%= @the_trip.trip_location %></div>
        <div><%= @the_trip.trip_duration_days %> days, <%= @the_trip.trip_start_date.strftime("%B %-d, %Y") %></div>
      </div>

      <div class="trip-actions">
        <a class="btn-rebuild" href="/modify/<%= @the_trip.id %>">
          Rebuild My Agenda
        </a>

        <a class="btn-delete" href="/delete_trip/<%= @the_trip.id %>">
          Delete This Trip
        </a>
      </div>

    </article>
    <hr>

    <h1>
      My Agenda
    </h1>

    <%
  start_date = @the_trip.trip_start_date
  end_date = @the_trip.trip_start_date + @the_trip.trip_duration_days.day-1.day
%>

<div class="agenda-carousel">
<button id="agenda-prev" class="agenda-arrow left">&lt;</button>
<div class="agenda-wrapper">
    <% (start_date..end_date).each_with_index do |date, i| %>
       <article class="agenda-day <%= 'active' if i == 0 %>">

          <div class="overflow-auto">
            <div class="day-header" style="color: #1c49a9ff;">Day <%= i + 1 %>: <%= date.strftime("%B %-d, %Y") %></div>
            <% this_day = @the_trip.trip_plans.where(date: date.strftime("%Y-%m-%d")) %>
<div class="overflow-auto">
            <table class="agenda-table">
              <thead>
                <th>Time</th>
                <th>Plan</th>
                <th>Location</th>
                <th>Get around</th>
              </thead>

              <tbody>
                <% this_day.order(:start_time).each do |a_day| %>
                  <tr>
                    <td><%= a_day.start_time.strftime("%I:%M&nbsp;%p").html_safe %> - <%= a_day.end_time.strftime("%I:%M&nbsp;%p").html_safe %></td>
              
                    <td class="plan-cell">
                      <div class="plan-brief">
                        <%= a_day.plan_brief %>
                        <span class="plan-full"><%= a_day.trip_plan %></span>
                      </div>
                    </td>

                   <!-- <td>-->
                      <%# short_loc = a_day.plan_location.split(",").first %>
                      <%#= link_to short_loc,
                  "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode(a_day.plan_location)}",
                  target: "_blank",
                  rel: "noopener" %>
<!--                    </td>-->
<!---------------------------------------------------->
                  <td class="place-cell"
                      data-location="<%= a_day.plan_location %>">
                    <a
                      href="https://www.google.com/maps/search/?api=1&query=<%= ERB::Util.url_encode(a_day.plan_location) %>"
                      target="_blank"
                      rel="noopener"
                      class="place-card-link">
                      <div class="place-card">
                        <div class="place-photo"></div>
                        <div class="place-info">
                          <div class="place-name">
                            <%= a_day.plan_location.split(",").first %>
                          </div>
                          <div class="place-rating"></div>
                        </div>
                      </div>
                    </a>
                  </td>

<!---------------------------------------------------->
                    <td style="font-size: 0.9rem;"><%= a_day.plan_details %></td>

                  </tr>
                <% end %>
              </tbody>
              
            </table>
            </div>

            <div
      id="map-day-<%= i + 1 %>"
      class="day-map"
      data-locations="<%= h(this_day.map { |p|
          { label: p.plan_location.split(",").first.split(" or ").first, address: p.plan_location }
        }.to_json) %>">
            </div>
          </div>

        </article>
    <% end %>
</div>



<button id="agenda-next" class="agenda-arrow right">&gt;</button>
</div>

<div class="agenda-pagination">
  <span id="agenda-label"></span>
</div>



    <!---------------------------- JAVA SCRIPT: Update my trip name in agenda ----------------------------->
    <script>
      document.getElementById("edit-trip-name-btn").addEventListener("click", () => {
        document.getElementById("trip-name-view").style.display = "none";
        document.getElementById("trip-name-edit").style.display = "flex";
      });

      document.getElementById("cancel-trip-name-btn").addEventListener("click", () => {
        document.getElementById("trip-name-edit").style.display = "none";
        document.getElementById("trip-name-view").style.display = "flex";
      });
    </script>
