<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/">Home</a></li>
    <li><%= @the_trip.trip_name%></li>
  </ul>
</nav>
<hr>

<article>
<div class="trip-hero">
  <% location = @the_trip.trip_location %>
  <% location = location.gsub(", ", "_")%>

 <img
    src="https://loremflickr.com/1200/400/<%=location%>"
    alt="<%= location %>"
    style="width: 9000px; height: auto; border-radius: 8px;"
  >

<h1 style="margin-top: 15px;"><%= @the_trip.trip_name %> </h1>


<div>
  <div><%= @the_trip.trip_location %></div>
  <div><%= @the_trip.trip_duration_days %> days, <%= Date.parse(@the_trip.trip_start_date) %></div>
</div>


<div class="trip-actions">
  <a class="btn-rebuild" href="/modify/<%= @the_trip.id %>">
    Rebuild My Agenda
  </a>
  
  <a class="btn-delete" href="/delete_trip/<%= @the_trip.id %>">
    Delete This Trip
  </a>
</div>

</article>
<hr>

<h1>
  My Agenda
</h1>

<%
  start_date = Date.parse(@the_trip.trip_start_date)
  end_date = Date.parse(@the_trip.trip_start_date) + @the_trip.trip_duration_days.day-1.day
%>

<% (start_date..end_date).each_with_index do |date, i| %>
  <div>
    <article>

      <div class="overflow-auto">
        <div class="day-header">Day <%= i + 1 %>: <%= date.strftime("%B %-d, %Y") %></div>
        <% this_day = @the_trip.trip_plans.where(date: date.strftime("%Y-%m-%d")) %>

        <table>
          <thead>
            <th>From</th>
            <th>To</th>
            <th>Plan</th>
            <th>Location</th>
            <th>Get around</th>
          </thead>

          <tbody>
            <% this_day.order(:start_time).each do |a_day| %>
              <tr>
                <td><%= a_day.start_time.strftime("%I:%M&nbsp;%p").html_safe %></td>
                <td><%= a_day.end_time.strftime("%I:%M&nbsp;%p").html_safe %></td>
                <td><%= a_day.trip_plan %></td>
                <td>
                  <% short_loc = a_day.plan_location.split(",").first %>
                  <%= link_to short_loc,
                  "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode(a_day.plan_location)}",
                  target: "_blank",
                  rel: "noopener" %>
                </td>
                <td><%= a_day.plan_details %></td>

              </tr>
            <% end %>
          </tbody>
        </table>
        
    <div
      id="map-day-<%= i + 1 %>"
      class="day-map"
      data-locations="<%= h(this_day.map { |p|
          { label: p.plan_location.split(",").first.split(" or ").first, address: p.plan_location }
        }.to_json) %>">
    </div>
      </div>

    </article>
  </div>
<% end %>
