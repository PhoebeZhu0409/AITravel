<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/">Home</a></li>
    <li><%= @the_trip.trip_name%></li>
  </ul>
</nav>
<hr>

<h1>
  <%= @the_trip.trip_name %>
</h1>

<a href="/delete_trip/<%= @the_trip.id %>">
  Delete
</a>

<article>

  <div class="overflow-auto">
    <table>
      <thead>
        <th>Location</th>
        <th>Trip Starts</th>
        <th>Days</th>
        <th> </th>
      </thead>

      <tbody>
        <tr>
          <td>
            <%= @the_trip.trip_location %>
          </td>
          <td>
            <%= @the_trip.trip_start_date  %><!--.strftime("%b %e, %Y")-->
          </td>
          <td>
            <%= @the_trip.trip_duration_days %>
          </td>
          <td>
            <a href="/modify/<%= @the_trip.id %>">
              Rebuild my agenda
            </a>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

</article>

<hr>

<article>

  <div class="overflow-auto">
    <table>
      <thead>
        <th>Trip plan</th>
        <th>Start time</th>
        <th>End time</th>
        <th>Date</th>
        <th>Plan location</th>
      </thead>

      <% this_trip = @the_trip.trip_plans %>
      <tbody>
        <% this_trip.each do |a_trip| %>
          <tr>
            <td>
              <%= a_trip.trip_plan %>
            </td>
            <td>
              <%= a_trip.start_time.strftime("%X") %>
            </td>
            <td>
              <%= a_trip.end_time.strftime("%X")  %>
            </td>
            <td>
              <%= a_trip.date  %>
            </td>
            <td>
              <%= a_trip.plan_location  %>
            </td>
          </tr>
        <% end %>

      </tbody>
    </table>
  </div>

</article>
<hr>
