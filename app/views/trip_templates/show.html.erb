<% content_for :title, @trip_show_page_title if @trip_show_page_title.present? %>

<%= render("trip_templates/page_profile_bar", left: capture do %>
  <nav aria-label="breadcrumb">
    <ul>
      <li><a href="<%= @trip_show_public_demo ? new_user_session_path : "/" %>">Home</a></li>
      <li><%= @the_trip.trip_name%></li>
    </ul>
  </nav>
<% end) %>
<hr>

<article>
  <div class="trip-hero">
    <% location = @the_trip.trip_location %>

    <div class="trip-hero-image-wrap">
      <img
        class="trip-hero-image"
        src="<%= trip_show_hero_src(@the_trip) %>"
        alt="<%= location %>"
        width="1200"
        height="400"
        loading="lazy"
        onerror="<%= trip_hero_image_onerror %>"
      >
    </div>

      <%# Inline trip name (signed-in) vs read-only title (public showcase) %>
      <div class="trip-name-inline-wrap">
        <% if @trip_show_public_demo %>
          <p class="trip-name-showcase-static"><%= @the_trip.trip_name %></p>
        <% else %>
          <%= form_with url: "/trip_name_update/#{@the_trip.id}", method: :post, local: true, html: { class: "trip-name-inline-form", data: { turbo: false } } do %>
            <input
              type="text"
              id="trip-name-field"
              class="trip-name-field"
              name="query_trip_name"
              value="<%= @the_trip.trip_name %>"
              autocomplete="off"
              spellcheck="false"
              aria-label="Trip name"
              data-original-name="<%= h(@the_trip.trip_name) %>"
            >
            <div class="trip-name-actions" id="trip-name-actions" hidden>
              <button type="submit" class="trip-name-save-btn" data-nopico>Save</button>
              <button type="button" class="trip-name-cancel-btn" id="trip-name-cancel-btn" data-nopico>Cancel</button>
            </div>
          <% end %>
        <% end %>
      </div>

      <div>
        <div><%= @the_trip.trip_location %></div>
        <div><%= trip_date_range_label(@the_trip) %></div>
      </div>

      <div class="trip-actions">
        <% unless @trip_show_public_demo %>
          <div class="trip-actions__primary">
            <% rebuild_blocked = !current_user.premium? && !current_user.can_generate_trip? %>
            <% if rebuild_blocked %>
              <span class="btn-rebuild btn-rebuild--disabled" aria-disabled="true" title="Generation limit reached for regular accounts">
                Rebuild My Agenda
              </span>
            <% else %>
              <a class="btn-rebuild" href="/modify/<%= @the_trip.id %>">
                Rebuild My Agenda
              </a>
            <% end %>

            <a class="btn-delete" href="/delete_trip/<%= @the_trip.id %>">
              Delete This Trip
            </a>
          </div>
        <% end %>

        <%# Full navigation in a new tab: avoids Turbo + broken “download” fetches; filename comes from Content-Disposition. %>
        <%= link_to "Share",
            @trip_show_public_demo ? @showcase_agenda_pdf_path : trip_agenda_pdf_path(path_id: @the_trip.id),
            class: "btn-share",
            target: "_blank",
            rel: "noopener noreferrer",
            data: { turbo: false } %>
      </div>

    </article>
    <hr>

    <h1>
      My Agenda
    </h1>

    <%
  start_date = @the_trip.trip_start_date
  end_date = @the_trip.trip_start_date + @the_trip.trip_duration_days.day-1.day
  agenda_dates = (start_date..end_date).to_a
  agenda_day_count = agenda_dates.length
%>

<div class="agenda-carousel">
  <%# Single card: toolbar (day toggles + jump) reads as part of the table block %>
  <div class="agenda-day-panel">
    <div class="agenda-integrated-toolbar">
      <div class="agenda-integrated-toolbar__days">
        <div class="agenda-day-picker agenda-day-picker--compact" id="agenda-day-picker">
          <button
            type="button"
            id="agenda-window-prev"
            class="agenda-tab-arrow agenda-tab-arrow--prev"
            aria-label="<%= agenda_day_count > 3 ? 'Show earlier days in list' : 'Previous day' %>"
            <% if agenda_day_count <= 1 %>hidden<% end %>>
            ‹
          </button>
          <div class="agenda-day-tabs" role="tablist" aria-label="Agenda days">
            <% agenda_dates.each_with_index do |date, i| %>
              <button
                type="button"
                role="tab"
                id="agenda-tab-<%= i %>"
                class="agenda-day-tab agenda-day-tab--compact <%= 'is-active' if i == 0 %>"
                data-day-index="<%= i %>"
                aria-selected="<%= i == 0 ? 'true' : 'false' %>"
                tabindex="<%= i == 0 ? 0 : -1 %>"
              >
                <span class="agenda-day-tab__num">Day <%= i + 1 %></span>
                <span class="agenda-day-tab__date"><%= agenda_brief_date(date) %></span>
              </button>
            <% end %>
          </div>
          <button
            type="button"
            id="agenda-window-next"
            class="agenda-tab-arrow agenda-tab-arrow--next"
            aria-label="<%= agenda_day_count > 3 ? 'Show later days in list' : 'Next day' %>"
            <% if agenda_day_count <= 1 %>hidden<% end %>>
            ›
          </button>
        </div>
      </div>
      <div class="agenda-integrated-toolbar__jump">
        <label class="agenda-jump-label" for="agenda-jump-select">Go to day</label>
        <select id="agenda-jump-select" class="agenda-jump-select agenda-jump-select--compact" data-nopico aria-label="Jump to a specific day">
          <% agenda_dates.each_with_index do |date, i| %>
            <option value="<%= i %>" <%= "selected" if i == 0 %>>
              Day <%= i + 1 %> — <%= agenda_brief_date(date) %>
            </option>
          <% end %>
        </select>
      </div>
    </div>

    <div class="agenda-wrapper">
    <% agenda_dates.each_with_index do |date, i| %>
       <article class="agenda-day <%= 'active' if i == 0 %>" data-day-index="<%= i %>">

          <div class="overflow-auto agenda-day-body">
            <% this_day = @the_trip.trip_plans.where(date: date.strftime("%Y-%m-%d")) %>

            <table class="agenda-table">
              <thead>
                <tr>
                  <th>Time</th>
                  <th>Plan</th>
                  <th>Location</th>
                  <th>Get around</th>
                </tr>
              </thead>

              <tbody>
                <% this_day.order(:start_time).each do |a_day| %>
                  <tr>

                    <td data-label="Time"><%= agenda_start_time_with_zone(a_day) %></td>
              
                    <td class="plan-cell" data-label="Plan">
                      <div class="plan-brief">
                        <%= a_day.plan_brief %>
                        <span class="plan-full"><%= a_day.trip_plan %></span>
                      </div>
                    </td>
                   <!-- <td>-->
                      <%# short_loc = a_day.plan_location.split(",").first %>
                      <%#= link_to short_loc,
                  a_day.google_maps_search_url,
                  target: "_blank",
                  rel: "noopener" %>
<!--                    </td>-->
<!---------------------------------------------------->
                    <td class="place-cell<%= " place-cell--cached" if a_day.google_place_cached? %>"
                        data-label="Location"
                        <% unless a_day.google_place_cached? %>data-location="<%= a_day.plan_location %>"<% end %>>
                      <a
                        href="<%= a_day.google_maps_search_url.presence || "#" %>"
                        target="_blank"
                        rel="noopener"
                        class="place-card-link">
                        <div class="place-card">
                          <div class="place-photo<%= " place-photo--failed" if a_day.google_place_cached? && !a_day.place_thumbnail.attached? && !showcase_plan_image(@the_trip, a_day) %>">
                            <% if (showcase_plan = showcase_plan_image(@the_trip, a_day)) %>
                              <%= image_tag showcase_plan, alt: (a_day.place_display_name.presence || a_day.plan_location) %>
                            <% elsif a_day.place_thumbnail.attached? %>
                              <%= image_tag a_day.place_thumbnail, alt: (a_day.place_display_name.presence || a_day.plan_location) %>
                            <% end %>
                          </div>
                          <div class="place-info">
                            <div class="place-name">
                              <%= a_day.place_display_name.presence || a_day.plan_location.split(",").first %>
                            </div>
                            <div class="place-rating">
                              <% if a_day.place_rating.present? %>
                                <%= number_with_precision(a_day.place_rating, precision: 1) %> ★ (<%= a_day.place_user_ratings_total.to_i %>)
                              <% end %>
                            </div>
                          </div>
                        </div>
                      </a>
                    </td>
  <!---------------------------------------------------->
                    <td class="agenda-get-around-cell" data-label="Get around">
                      <div class="agenda-get-around-body"><%= a_day.plan_details %></div>
                      <% if a_day.google_maps_search_url.present? || a_day.uber_dropoff_url.present? %>
                        <div class="agenda-get-around-links">
                          <% if (dir_href = a_day.google_maps_search_url.presence) %>
                            <%= link_to "Direction >", dir_href, target: "_blank", rel: "noopener", class: "agenda-direction-link" %>
                          <% end %>
                          <% if (uber_href = a_day.uber_dropoff_url.presence) %>
                            <%= link_to "Uber there",
                                uber_href,
                                target: "_blank",
                                rel: "noopener",
                                class: "agenda-uber-link",
                                data: { uber_mobile: a_day.uber_dropoff_mobile_url } %>
                          <% end %>
                        </div>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
              
            </table>


            <div
      id="map-day-<%= i + 1 %>"
      class="day-map"
      data-locations="<%= h(this_day.map { |p|
          row = {
            label: p.place_display_name.presence || p.plan_location.split(",").first,
            address: p.plan_location,
            maps_url: p.google_maps_search_url
          }
          if (photo_url = plan_photo_url(@the_trip, p))
            row[:photo_url] = photo_url
          end
          if p.place_rating.present?
            row[:rating] = p.place_rating.to_f
            row[:rating_count] = p.place_user_ratings_total.to_i
          end
          if p.place_latitude.present? && p.place_longitude.present?
            row[:lat] = p.place_latitude.to_f
            row[:lng] = p.place_longitude.to_f
          end
          row
        }.to_json) %>">
            </div>
            


          </div>

        </article>
    <% end %>
    </div>
  </div>
</div>



    <script>
      (function initTripNameInlineEdit() {
        var field = document.getElementById("trip-name-field");
        var actions = document.getElementById("trip-name-actions");
        var cancelBtn = document.getElementById("trip-name-cancel-btn");
        if (!field || !actions) return;

        var original = field.getAttribute("data-original-name") || field.value;

        function showActions() {
          actions.removeAttribute("hidden");
        }

        function hideActionsIfClean() {
          if (field.value === original) {
            actions.setAttribute("hidden", "");
          }
        }

        field.addEventListener("focus", showActions);
        field.addEventListener("input", function () {
          if (field.value !== original) {
            showActions();
          } else {
            hideActionsIfClean();
          }
        });

        field.addEventListener("blur", function () {
          setTimeout(function () {
            if (document.activeElement === cancelBtn || document.activeElement === actions.querySelector(".trip-name-save-btn")) {
              return;
            }
            if (field.value === original) {
              actions.setAttribute("hidden", "");
            }
          }, 120);
        });

        if (cancelBtn) {
          cancelBtn.addEventListener("click", function () {
            field.value = original;
            actions.setAttribute("hidden", "");
            field.blur();
          });
        }

        field.addEventListener("keydown", function (e) {
          if (e.key === "Enter" && !e.shiftKey) {
            e.preventDefault();
            var form = field.closest("form");
            if (form && field.value.trim() !== "") {
              form.requestSubmit();
            }
          }
          if (e.key === "Escape") {
            field.value = original;
            actions.setAttribute("hidden", "");
            field.blur();
          }
        });

      })();
    </script>

<script>
  (function () {
    function wireUberLinks() {
      var isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
      if (!isMobile) return;

      document.querySelectorAll("a.agenda-uber-link[data-uber-mobile]").forEach(function (link) {
        var mobileHref = link.getAttribute("data-uber-mobile");
        if (mobileHref) link.href = mobileHref;
      });
    }

    document.addEventListener("DOMContentLoaded", wireUberLinks);
    document.addEventListener("turbo:load", wireUberLinks);
  })();
</script>



<!-- Maps are loaded once from the layout; initItineraryMaps runs via googleMapsLoaded there. -->
