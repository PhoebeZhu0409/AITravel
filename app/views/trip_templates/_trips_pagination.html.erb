<%# locals: pagy, page_param, label %>
<% if pagy.pages > 1 %>
  <nav class="trips-pagination" aria-label="<%= label %>">
    <% if pagy.prev %>
      <%= app_link_to "Previous page", trips_tab_page_url(page_param, pagy.prev), class: "trips-page-btn" %>
    <% end %>

    <span class="trips-page-status">
      Page <%= pagy.page %> of <%= pagy.pages %>
      <span class="trips-page-count">(<%= pagy.from %>–<%= pagy.to %> of <%= pagy.count %>)</span>
    </span>

    <% if pagy.next %>
      <%= app_link_to "Next page", trips_tab_page_url(page_param, pagy.next), class: "trips-page-btn trips-page-btn--primary" %>
    <% end %>
  </nav>
<% end %>
