<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/">Home</a></li>
  </ul>
</nav>
<hr>

<article>
  <header>
    <h2>
      My future trips
    </h2>
  </header>
  <div class="overflow-auto">
    <table>
      <tbody>
        <% @list_of_trips.each do |a_trip| %>
          <tr>
            <td>
              <%= a_trip.trip_name %>
            </td>

              <td>
                <a href="/delete_trip/<%= a_trip.id %>">
                  Delete
                </a>
              </td>
            </tr>

        <% end %>

      </tbody>
    </table>
  </div>

</article>

<article>
  <header>
    <h2>
      Add a new trip
    </h2>
  </header>

  <form action="/insert_trip" method="post">
    <div>
      <label for="trip_name_box">
        Trip name
      </label>

      <input type="text" id="trip_name_box" name="query_trip_name">
    </div>

    <div>
      <label for="trip_location_box">Trip location</label>
      <input type="text"
         id="trip_location_box"
         name="query_trip_location"
         placeholder="Search a city..."
         autocomplete="off">
    </div>

    <div>
      <label for="trip_duration_days_box">
        Trip duration days
      </label>

      <input type="text" id="trip_duration_days_box" name="query_trip_duration_days">
    </div>

    <div>
      <label for="trip_start_date_box">
        Trip start date
      </label>

      <input type="date" id="trip_start_date_box" name="query_trip_start_date">
    </div>

    <div>
      <label for="trip_notes_box">
        Any other requirement for your trip?
      </label>

      <input type="text" id="trip_notes_box" name="query_trip_notes">
    </div>

    <button type="submit">
      Create my new trip for me!
    </button>
  </form>
</article>

<hr>

<script>
  function initAutocomplete() {
    new google.maps.places.Autocomplete(
      document.getElementById('trip_location_box'),
      {
        types: ['(cities)'],   // limits results to worldwide cities
      }
    );
  }
</script>

<script
  src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDXuv1tJQIJP92XV8Wo98Hy02e1nLGlmjs&libraries=places&callback=initAutocomplete"
  async
  defer></script>

