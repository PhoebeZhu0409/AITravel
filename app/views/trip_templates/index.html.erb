<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/">Home</a></li>
  </ul>
</nav>
<hr>

<article>
  <img
    src="https://loremflickr.com/1200/400/island"
    style="width: 100%; height: auto; border-radius: 8px;"
  >

    <header style="margin-top: 15px;">
      <h2>My Future Trips</h2>
    </header>

    <% active_trips = @list_of_trips.where(trip_start_date: (Date.today...)).order(:trip_start_date) %>

    <ul id="future-trips-list">
      <% active_trips.each_with_index do |a_trip, idx| %>
        <li class="<%= 'extra-trip' if idx >= 3 %>">
          <a href="/trips/<%= a_trip.id %>">
            📍 <%= a_trip.trip_name %>
          </a>
        </li>
      <% end %>
    </ul>

    <% if active_trips.size > 3 %>
      <button id="show-more-trips" class="btn-view-more">
        View more
      </button>
    <% end %>
  </article>

  <article>
    <header>
      <h2>
        Plan A New Trip
      </h2>
    </header>

    <form action="/insert_trip" method="post">
      <div>
        <label for="trip_name_box">
          Trip name
        </label>

        <input type="text" id="trip_name_box" name="query_trip_name">
      </div>

      <div>
        <label for="trip_location_box">Location</label>
        <input type="text"
         id="trip_location_box"
         name="query_trip_location"
         placeholder="Search a city..."
         autocomplete="off">
      </div>

      <div>
        <label for="trip_duration_days_box">
          How many days
        </label>

        <input type="number" id="trip_duration_days_box" name="query_trip_duration_days" step="1">
      </div>

      <div>
        <label for="trip_start_date_box">
          Trip starts
        </label>

        <input type="date" id="trip_start_date_box" name="query_trip_start_date">
      </div>

      <!-- Collapsible section -->
      <details class="collapsible">
        <summary class="collapsible-btn">Tell me more?</summary>

        <div class="content">

          <article>
            <div>
              <label>You want my trip to be...</label>
              <label><input type="radio" name="query_budget" value="luxury"> Luxury</label>
              <label><input type="radio" name="query_budget" value="budget friendly"> Budget friendly  </label>
              <label><input type="radio" name="query_budget" value="A mix of both luxury and budget friendly"> A mix of both</label>
            </div>
            <hr>
            <div>
              <label>You are...</label>
              <label><input type="radio" name="query_people" value="solo traveling"> Solo traveling</label>
              <label><input type="radio" name="query_people" value="traveling with my partner">Traveling with my partner</label>
              <label><input type="radio" name="query_people" value="traveling with my friends">Traveling with my friends</label>
              <label><input type="radio" name="query_people" value="traveling with my family">Traveling with my family</label>
            </div>
            <hr>
            <div>
              <label>Your trip should include...</label>
              <div>
                <label><input type="checkbox" name="query_todo[]" value="Local's favorite resturants or spots, or things to do that involves local culture ">Local's favorite food or spot, culture </label>
              </div>
              <div>
                <label><input type="checkbox" name="query_todo[]" value="Museums, art, and history">Museums, art, history</label>
              </div>
              <div>
                <label><input type="checkbox" name="query_todo[]" value="Outdoors & nature">Outdoors, nature</label>
              </div>
              <div>
                <label><input type="checkbox" name="query_todo[]" value="Nightlife & bars">Nightlife, bars</label>
              </div>
              <div>
                <label><input type="checkbox" name="query_todo[]" value="Shopping">Shopping</label>
              </div>
              <div>
                <label><input type="checkbox" name="query_todo[]" value="High-end restaurants and luxury experience">High-end restaurants and luxury experience </label>
              </div>
            </div>
          </article>

          <article>
            <div>
              <label for="live_area">
                Which area do you live? 
              </label>

              <input type="text" id="live_area" name="query_live_area">
            </div>

          </article>

        </div>
      </details>
      <!-- Collapsible section -->
      
      <article>
        <div>
          <label for="trip_notes_box">
            Anything else you want to tell me about? 
          </label>
          <% placeholder_text = <<~TEXT
            I would prefer...
            My goal is...
            I have to...
            I arrive/leave at...
            TEXT
          %>
          <textarea id="trip_notes_box" name="query_trip_notes" rows="4" placeholder="<%= placeholder_text %>"></textarea>
        </div>

      </article>

      <button type="submit">
        Build agenda for my trip!
      </button>
    </form>
  </article>

  <hr>

  <script>
    function initAutocomplete() {
      new google.maps.places.Autocomplete(
        document.getElementById('trip_location_box'),
        {
          types: ['(cities)'],   // limits results to worldwide cities
        }
      );
    }
  </script>

  <script
  src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDXuv1tJQIJP92XV8Wo98Hy02e1nLGlmjs&libraries=places&callback=initAutocomplete"
  async
  defer></script>

  <!--src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&libraries=places&callback=initAutocomplete"-->

  <article>
    <header style="margin-top: 15px;">
      <h2>Past Trips</h2>
    </header>

    <% past_trips = @list_of_trips.where(trip_start_date: (...Date.today)).order(trip_start_date: :desc) %>

    <ul id="past-trips-list">
      <% past_trips.each_with_index do |a_trip, idx| %>
        <li class="<%= 'extra-trip' if idx >= 3 %>">
          <a href="/trips/<%= a_trip.id %>">
            📍 <%= a_trip.trip_name %>
          </a>
        </li>
      <% end %>
    </ul>

    <% if past_trips.size > 3 %>
      <button id="show-more-past" class="btn-view-more">
        View more
      </button>
    <% end %>
  </article>
