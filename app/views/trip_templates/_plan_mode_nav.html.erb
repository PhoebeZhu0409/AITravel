<%# locals: active (:trip or :day) %>
<nav class="plan-mode-nav" aria-label="Planning mode">
  <div class="plan-mode-nav__tabs">
    <%= link_to root_path,
        class: "plan-mode-nav__tab#{' plan-mode-nav__tab--active' if active == :trip}",
        aria: { current: active == :trip ? "page" : false } do %>
      Plan A Trip
      <% if active == :trip %>
        <span class="plan-mode-nav__caret" aria-hidden="true"></span>
      <% end %>
    <% end %>

    <%= link_to plan_a_day_path,
        class: "plan-mode-nav__tab#{' plan-mode-nav__tab--active' if active == :day}",
        aria: { current: active == :day ? "page" : false } do %>
      Plan A Day
      <% if active == :day %>
        <span class="plan-mode-nav__caret" aria-hidden="true"></span>
      <% end %>
    <% end %>
  </div>
</nav>
