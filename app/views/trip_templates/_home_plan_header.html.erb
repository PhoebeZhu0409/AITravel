<%# locals: active (:trip or :day) %>
<div class="home-plan-header">
  <div class="home-plan-header__bar">
    <nav aria-label="breadcrumb">
      <ul>
        <li><a href="/">Home</a></li>
      </ul>
    </nav>

    <% if current_user.present? %>
      <div class="home-plan-header__account">
        <%= render "trip_templates/header_account" %>
      </div>
    <% end %>
  </div>

  <hr>

  <%= render "trip_templates/plan_mode_nav", active: active %>
</div>
