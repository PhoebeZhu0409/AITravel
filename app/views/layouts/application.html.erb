<script>
  // This is the function Google calls after Maps JS finishes loading
  function googleMapsLoaded() {
    function runMaps() {
      if (document.getElementById("trip_location_box")) initAutocomplete();
      if (document.querySelector(".day-map")) initItineraryMaps();
      if (document.querySelector(".place-cell")) initPlaceCards();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", runMaps);
    } else {
      runMaps();
    }
  }

  function initAutocomplete() {
    const input = document.getElementById('trip_location_box');
    if (!input) return;

    new google.maps.places.Autocomplete(input, {
      types: ['(cities)'],
    });
  }

function initSingleItineraryMap(el) {
  if (!el || !window.google || !google.maps) return;

  if (el.dataset.mapInitialized === "true" && el._itineraryMap) {
    google.maps.event.trigger(el._itineraryMap, "resize");
    return;
  }

  let locations;
  try {
    locations = JSON.parse(el.dataset.locations || "[]");
  } catch (e) {
    console.warn("Invalid map locations JSON:", e);
    return;
  }

  if (!locations.length) return;

  const map = new google.maps.Map(el, {
    zoom: 13,
    center: { lat: 0, lng: 0 }
  });

  el._itineraryMap = map;
  el.dataset.mapInitialized = "true";

  const bounds = new google.maps.LatLngBounds();
  const service = new google.maps.places.PlacesService(map);
  const infoWindow = new google.maps.InfoWindow({ maxWidth: 140 });
  let infoWindowCloseTimer = null;

  function supportsHover() {
    return window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  }

  const hoverCapable = supportsHover();

  function escapeMapHtml(str) {
    return String(str || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function mapsUrlFor(loc) {
    if (loc.maps_url) return loc.maps_url;
    if (loc.address) {
      return "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(loc.address);
    }
    return "";
  }

  function buildPopupHtml(loc) {
    const label = loc.label || loc.address || "Location";
    const mapsUrl = mapsUrlFor(loc);

    let html = '<div class="map-marker-popup">';
    if (mapsUrl) {
      html += '<a class="map-marker-popup__card" href="' + escapeMapHtml(mapsUrl) + '" target="_blank" rel="noopener">';
    } else {
      html += '<div class="map-marker-popup__card">';
    }

    if (loc.photo_url) {
      html += '<div class="map-marker-popup__photo">';
      html += '<img src="" alt="' + escapeMapHtml(label) + '" data-map-popup-photo loading="lazy">';
      html += "</div>";
    }

    html += '<div class="map-marker-popup__info">';
    if (mapsUrl) {
      html += '<span class="map-marker-popup__name">' + escapeMapHtml(label) + "</span>";
    } else {
      html += '<span class="map-marker-popup__name map-marker-popup__name--plain">' + escapeMapHtml(label) + "</span>";
    }
    if (loc.rating != null && !Number.isNaN(Number(loc.rating))) {
      const count = loc.rating_count != null ? loc.rating_count : 0;
      html += '<span class="map-marker-popup__rating">' + Number(loc.rating).toFixed(1) + " ★ (" + count + ")</span>";
    }
    html += "</div>";

    html += mapsUrl ? "</a>" : "</div>";
    html += "</div>";
    return html;
  }

  function scheduleInfoWindowClose() {
    clearTimeout(infoWindowCloseTimer);
    infoWindowCloseTimer = setTimeout(function () {
      infoWindow.close();
    }, 180);
  }

  function cancelInfoWindowClose() {
    clearTimeout(infoWindowCloseTimer);
  }

  function wireInfoWindowPopup(loc) {
    google.maps.event.addListenerOnce(infoWindow, "domready", function () {
      const container = document.querySelector(".gm-style-iw-d");
      if (!container) return;

      if (hoverCapable) {
        container.addEventListener("mouseenter", cancelInfoWindowClose);
        container.addEventListener("mouseleave", scheduleInfoWindowClose);
      }

      if (!loc.photo_url) return;

      const img = container.querySelector("img[data-map-popup-photo]");
      if (!img) return;

      img.addEventListener("error", function () {
        const photoWrap = img.closest(".map-marker-popup__photo");
        if (photoWrap) photoWrap.style.display = "none";
      });
      img.src = loc.photo_url;
    });
  }

  function openMarkerPopup(marker, loc) {
    cancelInfoWindowClose();
    infoWindow.close();
    infoWindow.setContent(buildPopupHtml(loc));
    infoWindow.open(map, marker);
    wireInfoWindowPopup(loc);
  }

  function addMarkerWithHover(position, loc) {
    const displayLabel = loc.label || loc.address || "Location";
    const marker = new google.maps.Marker({
      map: map,
      position: position,
      title: displayLabel,
      optimized: false
    });

    marker.addListener("click", function () {
      openMarkerPopup(marker, loc);
    });

    if (hoverCapable) {
      marker.addListener("mouseover", function () {
        openMarkerPopup(marker, loc);
      });

      marker.addListener("mouseout", scheduleInfoWindowClose);
    }

    bounds.extend(position);
  }

  if (!hoverCapable) {
    map.addListener("click", function () {
      infoWindow.close();
    });
  }

  function hasCachedCoords(loc) {
    return (
      loc.lat != null &&
      loc.lng != null &&
      !Number.isNaN(Number(loc.lat)) &&
      !Number.isNaN(Number(loc.lng))
    );
  }

  function finishBounds() {
    if (!bounds.isEmpty()) {
      map.fitBounds(bounds);
    }
    google.maps.event.trigger(map, "resize");
    setTimeout(function () {
      google.maps.event.trigger(map, "resize");
      if (!bounds.isEmpty()) {
        map.fitBounds(bounds);
      }
    }, 250);
  }

  let pendingApi = 0;
  locations.forEach((loc) => {
    if (hasCachedCoords(loc)) {
      addMarkerWithHover(
        { lat: Number(loc.lat), lng: Number(loc.lng) },
        loc
      );
      return;
    }

    pendingApi++;
    service.findPlaceFromQuery(
      {
        query: loc.address,
        fields: ["name", "geometry"]
      },
      (results, status) => {
        pendingApi--;
        if (
          status !== google.maps.places.PlacesServiceStatus.OK ||
          !results ||
          !results[0] ||
          !results[0].geometry
        ) {
          console.warn("Place lookup failed:", loc.address);
        } else {
          const place = results[0];
          addMarkerWithHover(place.geometry.location, {
            label: place.name || loc.label || loc.address,
            address: loc.address,
            maps_url: loc.maps_url || mapsUrlFor(loc)
          });
        }
        if (pendingApi === 0) {
          finishBounds();
        }
      }
    );
  });

  if (pendingApi === 0) {
    finishBounds();
  }
}

function initItineraryMaps() {
  document.querySelectorAll(".day-map").forEach((el) => {
    const dayArticle = el.closest(".agenda-day");
    const isActive = !dayArticle || dayArticle.classList.contains("active");
    if (isActive) {
      initSingleItineraryMap(el);
    }
  });
}




  function initPlaceCards() {
    const cells = document.querySelectorAll(".place-cell:not(.place-cell--cached)");
    if (!cells.length) return;

    // PlacesService needs a map or a dummy div
    const service = new google.maps.places.PlacesService(
      document.createElement("div")
    );

    cells.forEach((cell) => {
      const query = cell.dataset.location;
      if (!query) return;

      const card      = cell.querySelector(".place-card");
      if (!card) return;

      const nameEl    = card.querySelector(".place-name");
      const ratingEl  = card.querySelector(".place-rating");
      const photoWrap = card.querySelector(".place-photo");

      const request = {
        query: query,
        fields: ["name", "rating", "user_ratings_total", "photos"],
      };

      service.findPlaceFromQuery(request, (results, status) => {
        if (
          status !== google.maps.places.PlacesServiceStatus.OK ||
          !results ||
          !results[0]
        ) {
          return; // keep your fallback text
        }

        const place = results[0];

        // Name
        if (place.name && nameEl) {
          nameEl.textContent = place.name;
        }

        // Rating
        if (ratingEl && place.rating) {
          const count = place.user_ratings_total || 0;
          ratingEl.textContent = `${place.rating.toFixed(1)} ★ (${count})`;
        }

        // Photo
        if (photoWrap && place.photos && place.photos.length > 0) {
          const img = document.createElement("img");
          img.src = place.photos[0].getUrl({ maxWidth: 400, maxHeight: 400 });
          img.alt = place.name || query;
          photoWrap.appendChild(img);
        }
      });
    });
  }


  window.googleMapsLoaded  = googleMapsLoaded;
  window.initAutocomplete  = initAutocomplete;
  window.initItineraryMaps = initItineraryMaps;
  window.initSingleItineraryMap = initSingleItineraryMap;
    // expose if you like
  window.initPlaceCards = initPlaceCards;
</script>




<!----------- Agenda: day tabs (up to 3 visible), window arrows, jump select ------------>
<script>
  (function () {
    function initAgendaCarousel() {
      const carousel = document.querySelector(".agenda-carousel");
      if (!carousel || carousel.dataset.agendaWired === "1") return;

      const days = Array.from(document.querySelectorAll(".agenda-day"));
      const tabs = Array.from(document.querySelectorAll(".agenda-day-tab"));
      if (days.length === 0 || tabs.length === 0) return;

      carousel.dataset.agendaWired = "1";

      const jump = document.getElementById("agenda-jump-select");
      const prevWin = document.getElementById("agenda-window-prev");
      const nextWin = document.getElementById("agenda-window-next");

      const totalDays = days.length;
      let currentIndex = 0;
      let windowStart = 0;
      const maxWindowStart = Math.max(0, totalDays - 3);

      function ensureWindowContains(index) {
        if (totalDays <= 3) {
          windowStart = 0;
          return;
        }
        if (index < windowStart) windowStart = index;
        if (index > windowStart + 2) windowStart = index - 2;
        windowStart = Math.max(0, Math.min(maxWindowStart, windowStart));
      }

      function applyDayVisibility() {
        days.forEach((day, idx) => {
          day.classList.toggle("active", idx === currentIndex);
        });
      }

      function updateTabs() {
        tabs.forEach((tab, i) => {
          const inWindow = totalDays <= 3 || (i >= windowStart && i <= windowStart + 2);
          tab.hidden = !inWindow;
          tab.classList.toggle("is-active", i === currentIndex);
          tab.setAttribute("aria-selected", i === currentIndex ? "true" : "false");
          tab.tabIndex = i === currentIndex ? 0 : -1;
        });
        if (jump) jump.value = String(currentIndex);
        if (prevWin) {
          prevWin.hidden = totalDays <= 1;
          if (totalDays <= 3) {
            prevWin.disabled = currentIndex <= 0;
          } else {
            prevWin.disabled = windowStart <= 0;
          }
        }
        if (nextWin) {
          nextWin.hidden = totalDays <= 1;
          if (totalDays <= 3) {
            nextWin.disabled = currentIndex >= totalDays - 1;
          } else {
            nextWin.disabled = windowStart >= maxWindowStart;
          }
        }
      }

      function goToDay(index) {
        if (index < 0 || index >= totalDays) return;
        currentIndex = index;
        ensureWindowContains(currentIndex);
        applyDayVisibility();
        updateTabs();

        const activeDay = days[currentIndex];
        if (activeDay && window.initSingleItineraryMap) {
          const mapEl = activeDay.querySelector(".day-map");
          if (mapEl) window.initSingleItineraryMap(mapEl);
        }
      }

      applyDayVisibility();
      ensureWindowContains(0);
      updateTabs();

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const i = parseInt(tab.getAttribute("data-day-index"), 10);
          if (!Number.isNaN(i)) goToDay(i);
        });
      });

      if (prevWin) {
        prevWin.addEventListener("click", () => {
          if (totalDays <= 3) {
            if (currentIndex > 0) goToDay(currentIndex - 1);
          } else if (windowStart > 0) {
            windowStart -= 1;
            updateTabs();
          }
        });
      }
      if (nextWin) {
        nextWin.addEventListener("click", () => {
          if (totalDays <= 3) {
            if (currentIndex < totalDays - 1) goToDay(currentIndex + 1);
          } else if (windowStart < maxWindowStart) {
            windowStart += 1;
            updateTabs();
          }
        });
      }

      if (jump) {
        jump.addEventListener("change", () => {
          const i = parseInt(jump.value, 10);
          if (!Number.isNaN(i)) goToDay(i);
        });
      }
    }

    document.addEventListener("DOMContentLoaded", initAgendaCarousel);
    document.addEventListener("turbo:load", initAgendaCarousel);
  })();
</script>


