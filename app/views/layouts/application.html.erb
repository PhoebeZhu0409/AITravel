<script>
  // This is the function Google calls after Maps JS finishes loading
  function googleMapsLoaded() {
    function runMaps() {
      initAutocomplete();
      initItineraryMaps();
      initPlaceCards(); 
    }

    // If DOM isn't ready yet, wait for it
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", runMaps);
    } else {
      runMaps();
    }
  }

  function initAutocomplete() {
    const input = document.getElementById('trip_location_box');
    if (!input) return;

    new google.maps.places.Autocomplete(input, {
      types: ['(cities)'],
    });
  }

function initItineraryMaps() {
  document.querySelectorAll('.day-map').forEach((el) => {
    const locations = JSON.parse(el.dataset.locations || "[]");
    if (!locations.length) return;

    const map = new google.maps.Map(el, {
      zoom: 13,
      center: { lat: 0, lng: 0 }
    });

    const bounds = new google.maps.LatLngBounds();
    const service = new google.maps.places.PlacesService(map);

    function hasCachedCoords(loc) {
      return (
        loc.lat != null &&
        loc.lng != null &&
        !Number.isNaN(Number(loc.lat)) &&
        !Number.isNaN(Number(loc.lng))
      );
    }

    function finishBounds() {
      if (!bounds.isEmpty()) {
        map.fitBounds(bounds);
      }
    }

    let pendingApi = 0;
    locations.forEach((loc) => {
      if (hasCachedCoords(loc)) {
        const position = { lat: Number(loc.lat), lng: Number(loc.lng) };
        new google.maps.Marker({
          map: map,
          position: position,
          title: loc.label || loc.address
        });
        bounds.extend(position);
        return;
      }

      pendingApi++;
      service.findPlaceFromQuery(
        {
          query: loc.address,
          fields: ["name", "geometry"]
        },
        (results, status) => {
          pendingApi--;
          if (
            status !== google.maps.places.PlacesServiceStatus.OK ||
            !results ||
            !results[0] ||
            !results[0].geometry
          ) {
            console.warn("Place lookup failed:", loc.address);
          } else {
            const place = results[0];
            const position = place.geometry.location;
            new google.maps.Marker({
              map: map,
              position: position,
              title: place.name || loc.label
            });
            bounds.extend(position);
          }
          if (pendingApi === 0) {
            finishBounds();
          }
        }
      );
    });

    if (pendingApi === 0) {
      finishBounds();
    }
  });
}




  function initPlaceCards() {
    const cells = document.querySelectorAll(".place-cell:not(.place-cell--cached)");
    if (!cells.length) return;

    // PlacesService needs a map or a dummy div
    const service = new google.maps.places.PlacesService(
      document.createElement("div")
    );

    cells.forEach((cell) => {
      const query = cell.dataset.location;
      if (!query) return;

      const card      = cell.querySelector(".place-card");
      if (!card) return;

      const nameEl    = card.querySelector(".place-name");
      const ratingEl  = card.querySelector(".place-rating");
      const photoWrap = card.querySelector(".place-photo");

      const request = {
        query: query,
        fields: ["name", "rating", "user_ratings_total", "photos"],
      };

      service.findPlaceFromQuery(request, (results, status) => {
        if (
          status !== google.maps.places.PlacesServiceStatus.OK ||
          !results ||
          !results[0]
        ) {
          return; // keep your fallback text
        }

        const place = results[0];

        // Name
        if (place.name && nameEl) {
          nameEl.textContent = place.name;
        }

        // Rating
        if (ratingEl && place.rating) {
          const count = place.user_ratings_total || 0;
          ratingEl.textContent = `${place.rating.toFixed(1)} ★ (${count})`;
        }

        // Photo
        if (photoWrap && place.photos && place.photos.length > 0) {
          const img = document.createElement("img");
          img.src = place.photos[0].getUrl({ maxWidth: 400, maxHeight: 400 });
          img.alt = place.name || query;
          photoWrap.appendChild(img);
        }
      });
    });
  }


  window.googleMapsLoaded  = googleMapsLoaded;
  window.initAutocomplete  = initAutocomplete;
  window.initItineraryMaps = initItineraryMaps;
    // expose if you like
  window.initPlaceCards = initPlaceCards;
</script>





<!-------------------------------- Show more botton -------------------------------->

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const btn = document.getElementById("show-more-trips");
    if (!btn) return;

    btn.addEventListener("click", function () {
      document.querySelectorAll("#future-trips-list .extra-trip")
        .forEach(function (li) {
          li.style.display = "block";
        });

      // hide the button once expanded
      btn.style.display = "none";
    });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const btn = document.getElementById("show-more-past");
    if (!btn) return;

    btn.addEventListener("click", function () {
      document.querySelectorAll("#past-trips-list .extra-trip")
        .forEach(function (li) {
          li.style.display = "block";
        });

      btn.style.display = "none";
    });
  });
</script>


<!----------- Agenda: day tabs (up to 3 visible), window arrows, jump select ------------>
<script>
  (function () {
    function initAgendaCarousel() {
      const carousel = document.querySelector(".agenda-carousel");
      if (!carousel || carousel.dataset.agendaWired === "1") return;

      const days = Array.from(document.querySelectorAll(".agenda-day"));
      const tabs = Array.from(document.querySelectorAll(".agenda-day-tab"));
      if (days.length === 0 || tabs.length === 0) return;

      carousel.dataset.agendaWired = "1";

      const jump = document.getElementById("agenda-jump-select");
      const prevWin = document.getElementById("agenda-window-prev");
      const nextWin = document.getElementById("agenda-window-next");

      const totalDays = days.length;
      let currentIndex = 0;
      let windowStart = 0;
      const maxWindowStart = Math.max(0, totalDays - 3);

      function ensureWindowContains(index) {
        if (totalDays <= 3) {
          windowStart = 0;
          return;
        }
        if (index < windowStart) windowStart = index;
        if (index > windowStart + 2) windowStart = index - 2;
        windowStart = Math.max(0, Math.min(maxWindowStart, windowStart));
      }

      function applyDayVisibility() {
        days.forEach((day, idx) => {
          day.classList.toggle("active", idx === currentIndex);
        });
      }

      function updateTabs() {
        tabs.forEach((tab, i) => {
          const inWindow = totalDays <= 3 || (i >= windowStart && i <= windowStart + 2);
          tab.hidden = !inWindow;
          tab.classList.toggle("is-active", i === currentIndex);
          tab.setAttribute("aria-selected", i === currentIndex ? "true" : "false");
          tab.tabIndex = i === currentIndex ? 0 : -1;
        });
        if (jump) jump.value = String(currentIndex);
        if (prevWin) {
          prevWin.hidden = totalDays <= 1;
          if (totalDays <= 3) {
            prevWin.disabled = currentIndex <= 0;
          } else {
            prevWin.disabled = windowStart <= 0;
          }
        }
        if (nextWin) {
          nextWin.hidden = totalDays <= 1;
          if (totalDays <= 3) {
            nextWin.disabled = currentIndex >= totalDays - 1;
          } else {
            nextWin.disabled = windowStart >= maxWindowStart;
          }
        }
      }

      function goToDay(index) {
        if (index < 0 || index >= totalDays) return;
        currentIndex = index;
        ensureWindowContains(currentIndex);
        applyDayVisibility();
        updateTabs();
      }

      applyDayVisibility();
      ensureWindowContains(0);
      updateTabs();

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const i = parseInt(tab.getAttribute("data-day-index"), 10);
          if (!Number.isNaN(i)) goToDay(i);
        });
      });

      if (prevWin) {
        prevWin.addEventListener("click", () => {
          if (totalDays <= 3) {
            if (currentIndex > 0) goToDay(currentIndex - 1);
          } else if (windowStart > 0) {
            windowStart -= 1;
            updateTabs();
          }
        });
      }
      if (nextWin) {
        nextWin.addEventListener("click", () => {
          if (totalDays <= 3) {
            if (currentIndex < totalDays - 1) goToDay(currentIndex + 1);
          } else if (windowStart < maxWindowStart) {
            windowStart += 1;
            updateTabs();
          }
        });
      }

      if (jump) {
        jump.addEventListener("change", () => {
          const i = parseInt(jump.value, 10);
          if (!Number.isNaN(i)) goToDay(i);
        });
      }
    }

    document.addEventListener("DOMContentLoaded", initAgendaCarousel);
    document.addEventListener("turbo:load", initAgendaCarousel);
  })();
</script>


<!-----------  more google API Stuff: auto-fill ----------------------------------------->
<script>
  // Global callback for Google script
  window.googleMapsLoaded = function () {
    // only run if the input exists on THIS page
    if (document.getElementById("trip_location_box")) initAutocomplete();

    // only run if agenda maps exist on THIS page
    if (document.querySelector(".day-map")) initItineraryMaps();

    // only run if place cards exist on THIS page
    if (document.querySelector(".place-cell")) initPlaceCards();
  };

  // Works with Turbo navigation too
  document.addEventListener("turbo:load", () => {
    if (window.google && google.maps) window.googleMapsLoaded();
  });
</script>

<script
  src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&libraries=places&callback=googleMapsLoaded"
  async defer>
</script>

