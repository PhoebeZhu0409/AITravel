              <li class="app-header-sign-out-item">
                <%= top_nav_link_to "Sign out", "/users/sign_out" %>
              </li>
            </ul>
          <% else %>
            <ul>
              <li>
                <%= app_link_to "Sign up", "/users/sign_up" %>
              </li>
              <li>
                <%= app_link_to "Sign in", "/users/sign_in" %>
