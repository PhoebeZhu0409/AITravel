<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails 8 Template" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- The official Pico CSS stylesheet -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.conditional.css">
    <!-- The official Bootstrap utilities stylesheet -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/twbs/bootstrap@main/dist/css/bootstrap-utilities.css">
    <!-- Our modifications to default Pico CSS styles -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/firstdraft/pico.firstdraft.css@latest/pico.firstdraft.css">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="pico">
    <header>
      <div class="container-two-thirds">
        <nav>
          <ul>
            <li>
              <a href="/">
                <strong>
                  My Trips
                </strong>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <div class="container-two-thirds">
        <div class="text-success">          <%= notice %>        </div>
        <div class="text-danger">          <%= alert %>        </div>

        <%= yield %>
      </div>
    </main>

    <footer class="text-center">
      PhoebeZhu 2025. All rights reserved.
    </footer>


  <script>
    function initAutocomplete() {
      new google.maps.places.Autocomplete(
        document.getElementById('trip_location_box'),
        {
          types: ['(cities)'],   // limits results to worldwide cities
        }
      );
    }
  </script>
  <script
  src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDXuv1tJQIJP92XV8Wo98Hy02e1nLGlmjs&libraries=places&callback=initAutocomplete"
  async
  defer></script>

  <!--src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&libraries=places&callback=initAutocomplete"-->




<script>
  function initItineraryMaps() {
    document.querySelectorAll('.day-map').forEach(function(el) {
      const locations = JSON.parse(el.dataset.locations || '[]');
      if (!locations.length) return;

      // Basic map centered on Paris
      const map = new google.maps.Map(el, {
        zoom: 13,
        center: { lat: 48.8566, lng: 2.3522 }
      });

      const geocoder = new google.maps.Geocoder();
      const bounds = new google.maps.LatLngBounds();

      locations.forEach(function(loc) {
        geocoder.geocode({ address: loc.address }, function(results, status) {
          if (status === "OK" && results[0]) {
            const position = results[0].geometry.location;

            // ⭐ Simple marker — no click popup
            new google.maps.Marker({
              map: map,
              position: position,
              title: loc.label || loc.address   // hover label only
            });

            bounds.extend(position);
            map.fitBounds(bounds);
          }
        });
      });
    });
  }

  // make callback visible to Google Maps script
  window.initItineraryMaps = initItineraryMaps;
</script>


<script async
  src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDXuv1tJQIJP92XV8Wo98Hy02e1nLGlmjs&callback=initItineraryMaps">
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const btn = document.getElementById("show-more-trips");
    if (!btn) return;

    btn.addEventListener("click", function () {
      document.querySelectorAll("#future-trips-list .extra-trip")
        .forEach(function (li) {
          li.style.display = "block";
        });

      // hide the button once expanded
      btn.style.display = "none";
    });
  });
</script>


  </body>
</html>
