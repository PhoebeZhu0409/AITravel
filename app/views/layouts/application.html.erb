<!-------------------------------- Google API Functions -------------------------------->

<script
  src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&libraries=places&callback=googleMapsLoaded"
  async
  defer>
</script>

  <script>
    function initAutocomplete() {
      new google.maps.places.Autocomplete(
        document.getElementById('trip_location_box'),
        {
          types: ['(cities)'],   // limits results to worldwide cities
        }
      );
    }
  </script>

  <script
      src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&libraries=places&callback=initAutocomplete"
      async
      defer>
  </script>

<script>
  // This is the function Google calls after Maps JS finishes loading
  function googleMapsLoaded() {
    function runMaps() {
      initAutocomplete();
      initItineraryMaps();
      initPlaceCards(); 
    }

    // If DOM isn't ready yet, wait for it
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", runMaps);
    } else {
      runMaps();
    }
  }

  function initAutocomplete() {
    const input = document.getElementById('trip_location_box');
    if (!input) return;

    new google.maps.places.Autocomplete(input, {
      types: ['(cities)'],
    });
  }

  function initItineraryMaps() {
    document.querySelectorAll('.day-map').forEach(function(el) {
      const locations = JSON.parse(el.dataset.locations || '[]');
      if (!locations.length) return;

      const map = new google.maps.Map(el, {
        zoom: 13,
        center: { lat: 48.8566, lng: 2.3522 }
      });

      const geocoder = new google.maps.Geocoder();
      const bounds = new google.maps.LatLngBounds();

      locations.forEach(function(loc) {
        geocoder.geocode({ address: loc.address }, function(results, status) {
          if (status === "OK" && results[0]) {
            const position = results[0].geometry.location;

            new google.maps.Marker({
              map: map,
              position: position,
              title: loc.label || loc.address
            });

            bounds.extend(position);
            map.fitBounds(bounds);
          }
        });
      });
    });
  }



  function initPlaceCards() {
    const cells = document.querySelectorAll(".place-cell");
    if (!cells.length) return;

    // PlacesService needs a map or a dummy div
    const service = new google.maps.places.PlacesService(
      document.createElement("div")
    );

    cells.forEach((cell) => {
      const query = cell.dataset.location;
      if (!query) return;

      const card      = cell.querySelector(".place-card");
      if (!card) return;

      const nameEl    = card.querySelector(".place-name");
      const ratingEl  = card.querySelector(".place-rating");
      const photoWrap = card.querySelector(".place-photo");

      const request = {
        query: query,
        fields: ["name", "rating", "user_ratings_total", "photos"],
      };

      service.findPlaceFromQuery(request, (results, status) => {
        if (
          status !== google.maps.places.PlacesServiceStatus.OK ||
          !results ||
          !results[0]
        ) {
          return; // keep your fallback text
        }

        const place = results[0];

        // Name
        if (place.name && nameEl) {
          nameEl.textContent = place.name;
        }

        // Rating
        if (ratingEl && place.rating) {
          const count = place.user_ratings_total || 0;
          ratingEl.textContent = `${place.rating.toFixed(1)} ★ (${count})`;
        }

        // Photo
        if (photoWrap && place.photos && place.photos.length > 0) {
          const img = document.createElement("img");
          img.src = place.photos[0].getUrl({ maxWidth: 400, maxHeight: 400 });
          img.alt = place.name || query;
          photoWrap.appendChild(img);
        }
      });
    });
  }


  window.googleMapsLoaded  = googleMapsLoaded;
  window.initAutocomplete  = initAutocomplete;
  window.initItineraryMaps = initItineraryMaps;
    // expose if you like
  window.initPlaceCards = initPlaceCards;
</script>





<!-------------------------------- Show more botton -------------------------------->

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const btn = document.getElementById("show-more-trips");
    if (!btn) return;

    btn.addEventListener("click", function () {
      document.querySelectorAll("#future-trips-list .extra-trip")
        .forEach(function (li) {
          li.style.display = "block";
        });

      // hide the button once expanded
      btn.style.display = "none";
    });
  });
</script>


<!----------- flip pages. ------------>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const days = Array.from(document.querySelectorAll(".agenda-day"));
    if (days.length === 0) return;

    let currentIndex = 0;
    const prevBtn = document.getElementById("agenda-prev");
    const nextBtn = document.getElementById("agenda-next");
    const label   = document.getElementById("agenda-label");

    function applyVisibility() {
      days.forEach((day, idx) => {
        if (idx === currentIndex) {
          day.classList.add("active");
        } else {
          day.classList.remove("active");
        }
      });
    }

    function updateUI() {
      if (label) {
        label.textContent = `Day ${currentIndex + 1} of ${days.length}`;
      }
      if (prevBtn) prevBtn.disabled = currentIndex === 0;
      if (nextBtn) nextBtn.disabled = currentIndex === days.length - 1;
    }

    // Initial state
    currentIndex = 0;
    applyVisibility();
    updateUI();

    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        if (currentIndex > 0) {
          currentIndex -= 1;
          applyVisibility();
          updateUI();
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        if (currentIndex < days.length - 1) {
          currentIndex += 1;
          applyVisibility();
          updateUI();
        }
      });
    }
  });
</script>



