<% content_for :title, "Sign in · Nalu" %>
<div class="sign-in-page">
  <h1 class="sign-in-brand">
    <span class="sign-in-brand-word">Nalu</span><span class="sign-in-brand-suffix">.AI</span>
  </h1>
  <p class="sign-in-lead">Explore the world, or plan a perfect day.</p>

  <div class="sign-in-card">
    <p class="sign-in-title">Sign in</p>

    <div class="sign-in-form-block">
      <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { autocomplete: "off", class: "sign-in-form" }) do |f| %>
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    label: "Email",
                    input_html: { autocomplete: "off", autocapitalize: "none", spellcheck: "false", class: "sign-in-input" } %>
        <%= f.input :password,
                    required: false,
                    label: "Password",
                    input_html: { autocomplete: "new-password", class: "sign-in-input" } %>
        <% if devise_mapping.rememberable? %>
          <%= f.input :remember_me, as: :boolean, wrapper_html: { class: "sign-in-remember" } %>
        <% end %>
        <div class="sign-in-actions">
          <%= f.button :submit, "Log in", class: "sign-in-submit" %>
        </div>
      <% end %>

      <div class="sign-in-links">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>


<br>
    <p class="sign-in-tutorial">
    <a href="https://app.screencast.com/Sp4BIB4jNqbWG" class="sign-in-tutorial-link" target="_blank" rel="noopener noreferrer">🌊 Tutorial: How to use Nalu</a>
  </p>

  <p class="sign-in-meaning">
    
  </p>



</div>
