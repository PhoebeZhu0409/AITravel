
<div class="login-layout">
  <div class="login-info">
    <h3> Welcome to Nalu :)</h3>
    <p class="link-text"> 📝 I will help you plan your next trip! </p>
    <p class="link-text">📹 <a href="https://www.lonelyplanet.com/places">How to use</a><p>
      <h5>Come with me! :)</h5>

      <p class="list-item">
        <%= image_tag "GOWITHME.png", alt: "Go with me" %>
      </p>
    
    <div>
    <div class="wip-note">
      <p>From Phoebe: </p>
      <p>"As you can see...👀 Nalu is working on herself... but she’s ready to help you plan your next adventure today :)"</p>
      <br>
    </div>
    
      📧: <a class="link-text" href="mailto:phoebezhu1611@gmail.com"> Write to Phoebe?  (feedback/wishlist) </a>
    
    </div>

</div>

  <div class="login-form">
    <h2>Log in</h2>
    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { autocomplete: "off" }) do |f| %>
      <div class="form-group">
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "off", autocapitalize: "none", spellcheck: "false" } %>
        <%= f.input :password,
                    required: false,
                    input_html: { autocomplete: "new-password" } %>
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Log in" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>

<br>

  <div>
  <p class="brand-note"> "Nalu" (pronounced NAH-loo) is a Hawaiian word meaning “wave” and “flow.”🌊 <br> It represents strength, movement, and connection — just like you, on the edge of your next great adventure.</p>
  </div>
