<div class="login-layout">

  <section class="login-info">
    <h3> Welcome to Nalu :)</h3>
    <p class="brand-note"> Nalu (pronounced NAH-loo) is a Hawaiian word meaning “wave” and “flow.”🌊 <br> It represents strength, movement, and connection — just like you, on the edge of your next great adventure.</p>

    <div class="wip-note">
      <p>👀 As you can see...</p>
      <p>I am still a work in progress</p>
      <p>But I look forward to being helpful for you to plan your next trip 😇</p>
    </div>

      <h5>Come - and go with me :)</h5>
      <p class="list-item">
        <%= image_tag "GOWITHME.png", alt: "Go with me" %>
      </p>

  </section>

  <section class="login-form">
    <h2>Log in</h2>
    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { autocomplete: "off" }) do |f| %>
      <div class="form-group">
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "off", autocapitalize: "none", spellcheck: "false" } %>
        <%= f.input :password,
                    required: false,
                    input_html: { autocomplete: "new-password" } %>
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Log in" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>

</div>
