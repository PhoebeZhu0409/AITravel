<div class="devise-registration-edit">
  <%= render("trip_templates/page_profile_bar", left: capture do %>
    <h2 class="page-profile-bar__title">Edit <%= resource_name.to_s.humanize %></h2>
  <% end) %>

<dl class="account-status-readonly">
  <dt>ACCOUNT STATUS:</dt>
  <dd class="<%= 'account-status-readonly__value--premium' if resource.premium? %>">
    <%= resource.premium? ? "Premium" : "Regular" %>
  </dd>
</dl>

<%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, multipart: true }) do |f| %>
  <%= f.error_notification %>

  <div class="profile-avatar-preview">
    <%= user_avatar_tag(resource, class: "profile-avatar-preview__image") %>
  </div>

  <div class="form-inputs">
    <%= f.input :avatar,
                as: :file,
                label: "Profile picture",
                hint: "JPEG, PNG, or WebP (avoid HEIC from iPhone if desktop shows a broken image).",
                input_html: { accept: "image/jpeg,image/png,image/webp,image/gif" } %>
    <%= f.input :username,
                label: "Name",
                required: false,
                input_html: { autocomplete: "name" } %>
    <%= f.input :email, required: true, autofocus: true %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p>Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
    <% end %>
  </div>

  <section class="devise-password-section" aria-labelledby="change-password-heading">
    <h3 id="change-password-heading" class="devise-password-section__title">Change my password</h3>

    <div class="form-inputs">
      <%= f.input :password,
                  label: "New password (Leave blank if you don't want to change it)",
                  required: false,
                  input_html: { autocomplete: "new-password" } %>
      <%= f.input :password_confirmation,
                  label: "Password confirmation",
                  required: false,
                  input_html: { autocomplete: "new-password" } %>
    </div>
  </section>

  <div class="form-inputs devise-current-password-field">
    <h3 class="devise-password-section__title">Confirm changes</h3>
    <%= f.input :current_password,
                label: "Current password",
                hint: "You need to enter your current password to make any changes.",
                required: true,
                input_html: { autocomplete: "current-password" } %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "Update" %>
  </div>
<% end %>

<h3>Cancel my account</h3>

<div>Unhappy? <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete %></div>

<%= link_to "Back", :back %>
</div>
